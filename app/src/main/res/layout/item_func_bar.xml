<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/bg_card"
    android:padding="16dp"
    android:layout_marginBottom="16dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <TextView android:tag="func0" android:layout_width="40dp" android:layout_height="40dp"
            android:background="#337C4DFF" android:gravity="center"
            android:text="⚡" android:textSize="20dp"/>
        <TextView android:tag="funcLabel0" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="解锁" android:textSize="12sp" android:textColor="@color/text_secondary"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <TextView android:tag="func1" android:layout_width="40dp" android:layout_height="40dp"
            android:background="#337C4DFF" android:gravity="center"
            android:text="🔓" android:textSize="20dp"/>
        <TextView android:tag="funcLabel1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Root" android:textSize="12sp" android:textColor="@color/text_secondary"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <TextView android:tag="func2" android:layout_width="40dp" android:layout_height="40dp"
            android:background="#337C4DFF" android:gravity="center"
            android:text="🔌" android:textSize="20dp"/>
        <TextView android:tag="funcLabel2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="线刷" android:textSize="12sp" android:textColor="@color/text_secondary"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <TextView android:tag="func3" android:layout_width="40dp" android:layout_height="40dp"
            android:background="#337C4DFF" android:gravity="center"
            android:text="📝" android:textSize="20dp"/>
        <TextView android:tag="funcLabel3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="卡刷" android:textSize="12sp" android:textColor="@color/text_secondary"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <TextView android:tag="func4" android:layout_width="40dp" android:layout_height="40dp"
            android:background="#337C4DFF" android:gravity="center"
            android:text="🔥" android:textSize="20dp"/>
        <TextView android:tag="funcLabel4" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="救砖" android:textSize="12sp" android:textColor="@color/text_secondary"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
</LinearLayout>
