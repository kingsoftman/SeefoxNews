<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@color/bg_card"
    android:layout_marginBottom="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="刷机热榜" android:textSize="13sp" android:textColor="#7C4DFF"
        android:textStyle="bold" android:background="#337C4DFF"
        android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="4dp" android:paddingBottom="4dp"
        android:layout_marginEnd="12dp"/>
    <TextView android:id="@+id/hotTagTitle" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Magisk 27.0发布，支持Android 16"
        android:textSize="14sp" android:textColor="@color/text_primary" android:maxLines="1"
        android:ellipsize="end"/>
</LinearLayout>
